{
  "name": "arrakis-intelligence-platform-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "test": "node --test",
    "test:integration": "node --test --test-concurrency=1 integration/authRegistration.integration.js integration/focusTransaction.integration.js integration/profileRoadmap.integration.js integration/refreshToken.integration.js integration/teamMembership.integration.js integration/accountData.integration.js integration/rateLimitBuckets.integration.js",
    "check:import": "node -e \"import('./src/app.js').then(() => console.log('backend-import-ok'))\""
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.8.1"
  },
  "overrides": {
    "qs": "^6.16.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
